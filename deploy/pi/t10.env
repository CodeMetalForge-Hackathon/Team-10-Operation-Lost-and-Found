# Team 10 Pi settings, read by the t10-* services and install.sh. Edit, then: sudo systemctl restart 't10-*'
# TAK origin = where the first dropped node (N1) is; heading = true bearing of the camera's "up" at the start.
T10_LAT=42.35938882464616
T10_LON=-71.05658046185967
T10_HEADING=0
# Camera (drone/live_mosaic.py). Hand-carried demo: hide the carrier's feet, short exposure against blur.
T10_CAMERA_ARGS=--mask-bottom 0.3 --shutter-us 6000 --out data/live_mosaic
# The Pi's own Wi-Fi network (laptops, phones with ATAK, WinTAK join this). Channel 11: the ESP-NOW mesh is on 1.
T10_SSID=T10-FIELD
T10_PSK=t10-field-2026
T10_CHANNEL=11
